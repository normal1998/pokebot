# === eBay Developer (obligatoire) ===
# Recuperes sur developer.ebay.com > My Account > Application Keys > Production
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Marketplace eBay a interroger (EBAY_FR pour la France, EBAY_US pour les US, etc.)
EBAY_MARKETPLACE=EBAY_FR

# === Anthropic (obligatoire pour l'interpretation en langage naturel) ===
# Cle recuperee sur console.anthropic.com
ANTHROPIC_API_KEY=

# === Alertes email (optionnel mais recommande) ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=

# === Alertes Telegram (optionnel) ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === Reglages generaux ===
# Frequence de scan en minutes
SCAN_INTERVAL_MINUTES=15
# Seuil de decote (%) en dessous du prix marche pour declencher une alerte
# 30-40% = bonnes affaires nettes. Plus bas (10-15%) remonte beaucoup plus de resultats
# mais avec plus de "fausses affaires" (annonces mal groupees, frais de port sous-estimes, etc).
DEAL_THRESHOLD_PERCENT=30
# Port du serveur web
PORT=3000
